# Copy this file to .env.local and fill in values.
# For local dev, run `supabase start` from the repo root and copy the printed values.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STREAM_API_KEY=
STREAM_API_SECRET=
PORT=4000

# Comma-separated list of origins allowed to call this API (CORS). No
# wildcard, no spaces needed around commas. Add/remove origins here as
# environments change — no code changes required. Both hosts are listed
# for local dev because the Next.js dev server accepts requests on either
# (Node binds 0.0.0.0), and a browser visiting one vs. the other sends a
# different Origin header — see technical-notes.md "Security Headers & CORS".
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Used only by `npm run test:integration` (see src/__integration__/), which
# also reads SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY above. This is a direct
# Postgres connection (for test-data truncation), separate from the
# PostgREST-fronted SUPABASE_URL. Defaults to the standard `supabase start`
# local credentials if unset.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
