{
  "name": "@pavilion/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "demo:rating": "tsx src/domains/rating/rating.demo.ts",
    "seed:sessions": "tsx --env-file=.env.local src/scripts/seed-sessions.ts",
    "seed:admins": "tsx --env-file=.env.local src/scripts/seed-admins.ts",
    "seed:venues": "tsx --env-file=.env.local src/scripts/seed-venues.ts",
    "seed:all": "npm run seed:admins && npm run seed:sessions && npm run seed:venues",
    "invite:prod": "tsx --env-file=.env.prod.local src/scripts/invite-user.ts",
    "make-owner:prod": "tsx --env-file=.env.prod.local src/scripts/make-owner.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@pavilion/types": "*",
    "@supabase/supabase-js": "^2.108.2",
    "hono": "^4.7.11"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.11.0",
    "pg": "^8.13.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
